{
  "version": 1,
  "name": "company",
  "description": "One company-hosted OpenAI-compatible model",
  "entry": "adapter.mjs",
  "settings": {
    "model": {
      "type": "text",
      "label": "Model ID"
    },
    "key": {
      "type": "secret",
      "label": "API key"
    }
  },
  "inference": {
    "origin": "https://models.example.com",
    "basePath": "/v1",
    "auth": {
      "type": "bearer"
    },
    "operations": [
      {
        "method": "GET",
        "path": "/v1/models"
      },
      {
        "method": "POST",
        "path": "/v1/chat/completions"
      }
    ]
  }
}
